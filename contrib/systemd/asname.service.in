# asname REST API and web UI, as a system service.
# Installed by `sudo make install-service`; @VARS@ are filled in by make.
#
# It runs as a throwaway user (DynamicUser) that can write only its own
# database directory, /var/lib/asname. On the first start it downloads the
# core databases before it listens; follow it with
#   journalctl -u asname -f

[Unit]
Description=asname REST API and web UI
Documentation=https://github.com/flyingllama87/asname
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/asname --rest --allow-updates --web-dir @WEBDIR@ --listen @LISTEN@
Environment=ASNAME_DIR=%S/asname
Restart=on-failure
RestartSec=10s

DynamicUser=yes
StateDirectory=asname
StateDirectoryMode=0750
UMask=0027

# Hardening: no privileges, a read-only view of the system, and only the
# network families and system calls an HTTP server needs.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
